// GENERATED by build.py from core/firestore.rules + features/*/rules.part: edit those, then run python3 build.py
rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Zenvora Loop: multi-organization security rules
//
//  Super Admin (email below)  → onboards / offboards organizations, sets features, theme & billing.
//                               Can NOT read an organization's people or attendance unless that
//                               organization's Account Manager approves a time-limited support request.
//  Account Manager (orgadmin) → admin of their own organization only: people, roles, hierarchy,
//                               approves support access, sees their billing.
//  Manager                    → sees and corrects their organization's attendance.
//  Employee                   → checks in / out, sees own attendance, uses enabled features.
//  Proxy attendance            → staff the Account Manager ticks (e.g. reception) can check others in and out.
//  Clinic (feature)           → patients, appointments, treatments, photos, billing, accounts, reports;
//                               each person's clinic access is set by the Account Manager.
//
//  Every organization's data lives under /orgs/{orgId}/…, so organizations never see each other.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() {
      return signedIn() && request.auth.token.email == 'mohanmd.official@gmail.com';   // ← Super Admin
    }
    function orgDoc(o) { return get(/databases/$(database)/documents/orgs/$(o)).data; }
    function mem(o) { return get(/databases/$(database)/documents/orgs/$(o)/members/$(request.auth.uid)).data; }
    function isMember(o) {
      return signedIn() && orgDoc(o).status == 'active'
        && mem(o).active == true && mem(o).get('removed', false) != true;
    }
    // Owner and Account Manager (orgadmin) are both organization admins; only an Owner may change another Owner
    function isAdminRole(r) { return r in ['owner', 'orgadmin']; }
    function isOrgAdmin(o) { return isMember(o) && isAdminRole(mem(o).role); }
    function isOrgOwner(o) { return isMember(o) && mem(o).role == 'owner'; }
    function isOrgManager(o) { return isMember(o) && mem(o).role in ['owner', 'orgadmin', 'manager']; }
    function hasFeature(o, f) { return orgDoc(o).features.get(f, false) == true; }
    function supportOpen(o) { return isSuper() && orgDoc(o).get('supportUntil', 0) > request.time.toMillis(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function clinicOn(o) { return hasFeature(o, 'clinic'); }
    function clinicMember(o) { return isMember(o) && clinicOn(o); }
    // Proxy attendance: people the Account Manager ticks (members/{uid}.attProxy) may check others in and out
    function isProxy(o) { return isMember(o) && hasFeature(o, 'attendance') && mem(o).get('attProxy', false) == true; }
    function regAfter(o, id) { return getAfter(/databases/$(database)/documents/orgs/$(o)/attRegs/$(id)).data; }
    function memberOf(o, uid) { return get(/databases/$(database)/documents/orgs/$(o)/members/$(uid)).data; }
    function approverOf(o, uid) {
      return memberOf(o, uid).get('reportsTo', '') != '' ? memberOf(o, uid).reportsTo : orgDoc(o).get('adminUid', '');
    }
    function isOwner(o) { return clinicMember(o) && (isAdminRole(mem(o).role) || mem(o).get('isChief', false) == true); }
    function perm(o, p) { return clinicMember(o) && (isAdminRole(mem(o).role) || mem(o).get('perms', {}).get(p, false) == true); }

    // Login directory: which organization a user belongs to
    match /accounts/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      allow create: if isSuper()
        || (request.resource.data.keys().hasOnly(['orgId', 'email', 'createdAt'])
            && isOrgAdmin(request.resource.data.orgId));
      allow update, delete: if isSuper();
    }

    // Sign-in page branding for an organization's short link (<app>/<link name>): name, colour, logo, active, orgId.
    // The only thing anyone can read without signing in. Written by the Super Admin, or by that organization's
    // Account Manager for its own link name (the org ID or the name the Super Admin set in orgs/{id}.link).
    match /brand/{b} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['orgId', 'name', 'color', 'logo', 'active', 'at'])
        && (isSuper()
            || (isOrgAdmin(request.resource.data.orgId)
                && (b == request.resource.data.orgId || b == orgDoc(request.resource.data.orgId).get('link', ''))
                && (resource == null || resource.data.get('orgId', request.resource.data.orgId) == request.resource.data.orgId)));
    }

    match /orgs/{o} {
      allow read: if isSuper() || isMember(o);
      allow create: if isSuper() && request.resource.data.get('supportUntil', 0) == 0;
      // Super Admin manages plan/features/status but can't grant itself support access;
      // the Account Manager can only approve/revoke support access and keep the seat count.
      allow update: if (isSuper() && !changed().hasAny(['supportUntil', 'supportBy']))
        || (isOrgAdmin(o) && changed().hasOnly(['supportUntil', 'supportBy', 'seats', 'logo', 'homeDefault', 'planner', 'hasOwner'])
            && (!changed().hasAny(['hasOwner']) || request.resource.data.hasOwner == true));    // once an Owner exists, only Owners name Owners

      // Planning Board, shared tasks: a task given to a colleague. Only its reporter (createdBy), its assignee
      // and the Account Manager can see it. Who may give tasks is the Account Manager's switch: orgs/{o}.planner.assign
      function planOn() { return isMember(o) && hasFeature(o, 'agenda'); }
      function assignMode() { return orgDoc(o).get('planner', {}).get('assign', 'all'); }
      function canAssign() { return assignMode() == 'all' || (assignMode() == 'mgr' && isOrgManager(o)); }
      match /tasks/{t} {
        allow read: if planOn() && (resource.data.createdBy == request.auth.uid
          || resource.data.assigneeUid == request.auth.uid || isOrgAdmin(o));
        allow create: if planOn() && canAssign() && request.resource.data.createdBy == request.auth.uid;
        allow update: if planOn()
          && (resource.data.createdBy == request.auth.uid || resource.data.assigneeUid == request.auth.uid || isOrgAdmin(o))
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.get('assigneeUid', '') == resource.data.get('assigneeUid', '') || canAssign()
              || resource.data.createdBy == request.auth.uid);
        allow delete: if planOn() && (resource.data.createdBy == request.auth.uid || isOrgAdmin(o));
      }
      // People directory for picking an assignee: names & titles only (members/ stays private to managers)
      match /dir/{uid} {
        allow read: if isMember(o);
        allow create, update: if isOrgAdmin(o)
          || (isMember(o) && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'title', 'active', 'at'])
              && request.resource.data.active == true);
        allow delete: if isOrgAdmin(o);
      }

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isOrgManager(o) || supportOpen(o) || isProxy(o);
        // Super Admin may only create the Account Manager it has just assigned on the org
        allow create: if (isOrgAdmin(o) && (request.resource.data.role != 'owner' || isOrgOwner(o) || !orgDoc(o).get('hasOwner', false)))
          || (isSuper() && request.resource.data.role == 'orgadmin' && orgDoc(o).get('adminUid', '') == uid);
        // only an Owner may change an Owner or make someone Owner (the first Owner may be named by the Account Manager)
        allow update: if (isOrgAdmin(o) && (isOrgOwner(o) || (resource.data.role != 'owner'
              && (request.resource.data.role != 'owner' || !orgDoc(o).get('hasOwner', false)))))
          || (isOrgManager(o) && changed().hasOnly(['att']))
          || (signedIn() && request.auth.uid == uid && changed().hasOnly(['mustChangePassword', 'lastLogin'])
              && request.resource.data.mustChangePassword == false);
      }


      // Audit log: who changed roles, attendance requirements, assists, bills. Write-once, admins (and the Chief doctor) read it.
      match /audit/{x} {
        allow read: if isOrgAdmin(o) || (isMember(o) && mem(o).get('isChief', false) == true) || supportOpen(o);
        allow create: if isMember(o) && request.resource.data.by == request.auth.token.email;
        allow update, delete: if false;
      }

      // Support access requests: Super Admin asks, Account Manager decides
      match /accessRequests/{r} {
        allow read: if isSuper() || isOrgAdmin(o);
        allow create: if isSuper() && request.resource.data.status == 'pending';
        allow update: if isOrgAdmin(o) || (isSuper() && request.resource.data.status == 'cancelled');
      }

      // Logins that existed before organizations: Super Admin moves them in, Account Manager adds them
      match /pending/{uid} {
        allow read, delete: if isOrgAdmin(o);
        allow create: if isSuper();
      }

      // Feature rules: build.py puts each features/<name>/rules.part here
      // ── feature: Payroll (Attendance) (features/payroll/rules.part) ──
      // Attendance (feature: attendance). Staff check-ins are stamped with server time.
      match /attendance/{uid}/events/{eventId} {
        allow read: if (hasFeature(o, 'attendance')
                        && (isOrgManager(o) || isProxy(o) || (signedIn() && request.auth.uid == uid && isMember(o))))
          || supportOpen(o);
        allow create: if hasFeature(o, 'attendance') && (isOrgManager(o)
          || (signedIn() && request.auth.uid == uid && isMember(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src'])
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.src == 'self'
              && request.resource.data.at == request.time)
          || (isProxy(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src', 'by'])
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.src == 'proxy'
              && request.resource.data.by == request.auth.uid
              && request.resource.data.at == request.time)
          // an approved regularization: written by the person who approved it, at exactly the requested time
          || (isMember(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src', 'reg', 'by'])
              && request.resource.data.src == 'reg'
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.by == request.auth.uid
              && eventId == request.resource.data.reg + '-' + request.resource.data.type
              && regAfter(o, request.resource.data.reg).uid == uid
              && regAfter(o, request.resource.data.reg).status == 'approved'
              && regAfter(o, request.resource.data.reg).decidedBy == request.auth.uid
              && request.resource.data.at.toMillis() == regAfter(o, request.resource.data.reg).get(request.resource.data.type == 'in' ? 'inAt' : 'outAt', -1)));
        allow update, delete: if hasFeature(o, 'attendance') && isOrgManager(o);
      }

      // Attendance regularization requests: the person (or a Proxy attendance person for them) asks;
      // their immediate reporting manager (or the Account Manager if they report to no one) approves.
      match /attRegs/{r} {
        allow read: if hasFeature(o, 'attendance') && isMember(o)
          && (resource.data.uid == request.auth.uid || resource.data.by == request.auth.uid
              || resource.data.approver == request.auth.uid || isOrgAdmin(o));
        allow create: if hasFeature(o, 'attendance') && isMember(o)
          && request.resource.data.status == 'pending'
          && request.resource.data.by == request.auth.uid
          && (request.resource.data.uid == request.auth.uid || isProxy(o))
          && request.resource.data.approver != request.resource.data.uid
          && request.resource.data.approver == approverOf(o, request.resource.data.uid);
        allow update: if hasFeature(o, 'attendance') && isMember(o)
          && (resource.data.approver == request.auth.uid || isOrgAdmin(o))
          && resource.data.uid != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && changed().hasOnly(['status', 'decidedBy', 'decidedName', 'decidedAt']);
        allow delete: if isMember(o) && resource.data.by == request.auth.uid && resource.data.status == 'pending';
      }

      // ── feature: Dental Clinic (features/dental-clinic/rules.part) ──
      // ── Clinic (feature: clinic). Who may do what is set per person by the Account Manager (members/{uid}.perms).
      match /patients/{pid} {
        allow read: if perm(o, 'patients') || perm(o, 'appointments') || perm(o, 'treatments') || perm(o, 'billing') || supportOpen(o);
        allow create: if perm(o, 'patients');
        allow update: if perm(o, 'patients') || perm(o, 'treatments');
        allow delete: if isOrgAdmin(o) && clinicOn(o);
        match /photos/{ph} {
          allow read: if perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'treatments');
        }
        match /photoData/{ph} {
          allow read: if perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'treatments');
        }
        match /docs/{dk} {
          allow read: if perm(o, 'patients') || perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'patients') || perm(o, 'treatments');
        }
        match /docData/{dk} {
          allow read: if perm(o, 'patients') || perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'patients') || perm(o, 'treatments');
        }
      }
      match /appointments/{a} {
        allow read: if perm(o, 'appointments') || perm(o, 'treatments') || perm(o, 'reports') || perm(o, 'doctorReports') || supportOpen(o);
        allow write: if perm(o, 'appointments') || perm(o, 'treatments');
      }
      // Treatments: once on a live, issued bill (billId) they are locked until that bill is cancelled (only the visit date may move)
      function billDoc(b) { return get(/databases/$(database)/documents/orgs/$(o)/bills/$(b)).data; }
      function billAfter(b) { return getAfter(/databases/$(database)/documents/orgs/$(o)/bills/$(b)).data; }
      // edits of issued bills and payments: Owner, Account Manager, or the 'Edit / cancel bills' permission, always with a reason in history
      function moneyEditor() { return isOrgAdmin(o) || (perm(o, 'billing') && perm(o, 'cancelBills')); }
      function reasonAdded() { return request.resource.data.history.size() == resource.data.get('history', []).size() + 1
        && request.resource.data.history[request.resource.data.history.size() - 1].reason.size() > 0; }
      function tFree() { return resource.data.get('billId', '') == '' || billDoc(resource.data.billId).status in ['cancelled', 'draft']; }
      match /treatments/{t} {
        allow read: if perm(o, 'treatments') || perm(o, 'billing') || perm(o, 'reports') || perm(o, 'doctorReports') || perm(o, 'accounts') || supportOpen(o);
        allow create: if perm(o, 'treatments');
        allow delete: if perm(o, 'treatments') && tFree();
        allow update: if (perm(o, 'treatments') && tFree())
          || (perm(o, 'patients') && changed().hasOnly(['docAttached']))
          || ((perm(o, 'treatments') || perm(o, 'billing')) && changed().hasOnly(['date']))
          // an edit of its (issued) bill changes the charge / discount, in the same write as the bill
          || (moneyEditor() && changed().hasOnly(['cost', 'discount']) && billAfter(resource.data.billId).history.size() > billDoc(resource.data.billId).get('history', []).size())
          // issuing a bill puts the treatment on it (the bill must exist after the write and list this bill's id)
          || ((perm(o, 'billing') || perm(o, 'treatments')) && changed().hasOnly(['billId']) && tFree()
              && billAfter(request.resource.data.billId).status in ['pending', 'ack', 'partly', 'paid']);
      }
      // Bills: never deleted. A draft may change; an issued bill's items and total never change; `paid` moves only together with a new
      // payment record (lastPay) and never above the total; cancelling needs a reason (with payments: an admin or "Cancel bills").
      // One live bill per visit: the appointment points at it, and a new one is refused while the old one is not cancelled.
      match /bills/{b} {
        function nb() { return request.resource.data; }
        function ob() { return resource.data; }
        function apptAfter() { return getAfter(/databases/$(database)/documents/orgs/$(o)/appointments/$(nb().appointmentId)).data; }
        function apptBefore() { return get(/databases/$(database)/documents/orgs/$(o)/appointments/$(nb().appointmentId)).data; }
        function payAfter() { return getAfter(/databases/$(database)/documents/orgs/$(o)/payments/$(nb().lastPay)).data; }
        allow read: if perm(o, 'billing') || perm(o, 'treatments') || perm(o, 'reports') || perm(o, 'accounts') || supportOpen(o);
        allow create: if perm(o, 'billing') && nb().status in ['draft', 'ack'] && nb().total == nb().subtotal - nb().discount && nb().total >= 0 && nb().paid >= 0
          && (nb().paid == 0 || (nb().get('replaces', '') != '' && billAfter(nb().replaces).status == 'cancelled'
                && billAfter(nb().replaces).get('replacedBy', '') == b && billDoc(nb().replaces).paid == nb().paid))
          && (nb().get('appointmentId', '') == '' || (apptAfter().get('billId', '') == b
                && (apptBefore().get('billId', '') == '' || billAfter(apptBefore().billId).status == 'cancelled')));
        allow update: if perm(o, 'billing') && ob().status != 'cancelled'
          && !changed().hasAny(['billNo', 'patientId', 'appointmentId', 'createdAt', 'createdBy', 'replaces']) && (
            // a draft is edited or issued
            (ob().status == 'draft' && nb().paid == ob().paid && nb().total == nb().subtotal - nb().discount && nb().total >= nb().paid
                && (nb().status in ['draft', 'ack'] || (nb().paid > 0 && ((nb().paid == nb().total && nb().status == 'paid') || (nb().paid < nb().total && nb().status == 'partly')))))
            // acknowledged by the patient
            || (ob().status == 'pending' && nb().status == 'ack' && changed().hasOnly(['status', 'ackBy', 'ackAt', 'history']))
            // a payment: paid rises by exactly the new payment's amount, never above the total
            || (ob().status in ['pending', 'ack', 'partly'] && changed().hasOnly(['paid', 'status', 'lastPay', 'ackBy', 'ackAt'])
                && nb().lastPay != ob().get('lastPay', '') && !exists(/databases/$(database)/documents/orgs/$(o)/payments/$(nb().lastPay))
                && payAfter().billId == b && nb().paid == ob().paid + payAfter().amount && nb().paid <= ob().total
                && ((nb().paid == ob().total && nb().status == 'paid') || (nb().paid < ob().total && nb().status == 'partly')))
            // reopen an issued bill with no payment back to draft
            || (ob().status in ['pending', 'ack'] && ob().paid == 0 && nb().status == 'draft' && changed().hasOnly(['status', 'history']))
            // an edit with a reason: date / charges / discounts (status follows paid vs total), or a payment's new amount (editPay)
            || (moneyEditor() && ob().status != 'draft' && reasonAdded() && nb().total == nb().subtotal - nb().discount && nb().total >= 0
                && changed().hasOnly(['items', 'subtotal', 'discount', 'total', 'date', 'status', 'history']) && nb().paid == ob().paid
                && ((nb().paid > 0 && nb().paid >= nb().total && nb().status == 'paid') || (nb().paid > 0 && nb().paid < nb().total && nb().status == 'partly') || (nb().paid == 0 && nb().status in ['ack', 'pending'])))
            || (moneyEditor() && reasonAdded() && changed().hasOnly(['paid', 'status', 'editPay', 'history'])
                && getAfter(/databases/$(database)/documents/orgs/$(o)/payments/$(nb().editPay)).data.billId == b
                && nb().paid == ob().paid - get(/databases/$(database)/documents/orgs/$(o)/payments/$(nb().editPay)).data.amount + getAfter(/databases/$(database)/documents/orgs/$(o)/payments/$(nb().editPay)).data.amount
                && nb().paid <= ob().total && ((nb().paid >= ob().total && nb().status == 'paid') || (nb().paid > 0 && nb().paid < ob().total && nb().status == 'partly') || (nb().paid == 0 && nb().status == 'ack')))
            // cancel, with a reason
            || (nb().status == 'cancelled' && changed().hasOnly(['status', 'cancel', 'replacedBy', 'history']) && nb().cancel.reason.size() > 0
                && (ob().paid == 0 || isOrgAdmin(o) || perm(o, 'cancelBills'))));
        allow delete: if false;
      }
      // Payments: never edited or deleted. A payment names its bill, which records it as lastPay in the same write.
      // A refund (negative amount) only for a bill being cancelled. Imports (Dentee) and older payments have no bill.
      match /payments/{p} {
        allow read: if perm(o, 'billing') || perm(o, 'reports') || perm(o, 'accounts') || perm(o, 'tally') || supportOpen(o);
        allow create: if perm(o, 'billing') && (
          (request.resource.data.get('kind', 'payment') == 'payment' && request.resource.data.amount > 0 && request.resource.data.get('billId', '') != ''
            && billAfter(request.resource.data.billId).get('lastPay', '') == p)
          || (request.resource.data.get('kind', '') == 'refund' && request.resource.data.amount < 0
            && billAfter(request.resource.data.billId).status == 'cancelled' && billAfter(request.resource.data.billId).cancel.payments == 'refunded'
            && request.resource.data.amount == 0 - billDoc(request.resource.data.billId).paid)
          || (isOrgAdmin(o) && request.resource.data.get('imported', false) == true));
        // a repeated Dentee import may rewrite its own imported payments (never one on a bill)
        allow update: if (moneyEditor() && resource.data.get('kind', 'payment') == 'payment' && request.resource.data.amount > 0 && reasonAdded()
            && changed().hasOnly(['date', 'amount', 'mode', 'txnRef', 'note', 'cash', 'history'])
            && (request.resource.data.amount == resource.data.amount || resource.data.get('billId', '') == ''
                || (billAfter(resource.data.billId).get('editPay', '') == p
                    && billAfter(resource.data.billId).history.size() > billDoc(resource.data.billId).get('history', []).size())))
          || isOrgAdmin(o) && resource.data.get('imported', false) == true && request.resource.data.get('imported', false) == true && resource.data.get('billId', '') == '';
        allow delete: if false;
      }
      // Accounts ledger: income, expenses & bills, petty cash, consultant payments.
      // Front desk may only record petty cash spends; only Accounts (the owner) tops petty cash up.
      match /ledger/{l} {
        allow read: if perm(o, 'accounts') || perm(o, 'reports') || supportOpen(o) || isOwner(o)
          || (perm(o, 'petty') && resource.data.kind in ['petty', 'pettyspend'])
          || (perm(o, 'tally') && resource.data.kind == 'expense');
        // the Chief doctor (owner) may enter the per-patient cost of a consultant's visit (ledger id cf-<appointmentId>)
        allow create: if perm(o, 'accounts') || (perm(o, 'petty') && request.resource.data.kind == 'pettyspend')
          || (isOwner(o) && l == 'cf-' + request.resource.data.appointmentId && request.resource.data.kind == 'expense')
          // billing: a patient's change taken from the petty box (ledger chg-<paymentId>, written with the payment)
          || (perm(o, 'billing') && l == 'chg-' + request.resource.data.paymentId && request.resource.data.kind == 'pettyspend' && request.resource.data.change == true);
        allow update: if perm(o, 'accounts')
          || (isOwner(o) && l == 'cf-' + request.resource.data.appointmentId && request.resource.data.kind == 'expense' && resource.data.appointmentId == request.resource.data.appointmentId);
        allow delete: if perm(o, 'accounts') || (isOwner(o) && l == 'cf-' + resource.data.appointmentId)
          || (perm(o, 'billing') && l == 'chg-' + resource.data.paymentId && resource.data.get('change', false) == true);    // deleting the payment gives the change back
      }
      // Audit log: a copy of every deleted money record (ledger entries, tallies). Write-once: nobody can change or remove it.
      match /auditLog/{x} {
        allow read: if perm(o, 'accounts') || isOwner(o) || supportOpen(o);
        allow create: if (perm(o, 'accounts') || perm(o, 'tally') || perm(o, 'petty') || isOwner(o)) && request.resource.data.by == request.auth.token.email;
        allow update, delete: if false;
      }
      match /ledgerDocs/{l} {
        allow read, write: if perm(o, 'accounts');
      }
      match /tallies/{d} {
        allow read: if perm(o, 'accounts') || perm(o, 'tally') || perm(o, 'reports') || supportOpen(o);
        allow write: if perm(o, 'accounts') || perm(o, 'tally');
      }
      match /vendors/{v} {
        allow read: if perm(o, 'accounts') || perm(o, 'reports') || supportOpen(o);
        allow write: if perm(o, 'accounts');
      }
      match /doctors/{d} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /treatmentTypes/{t} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /medicines/{m} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /clinicMeta/{d} {
        // 'orgTasks': organization reminders everyone shares and anyone may close (patient follow-ups, documents, descriptions)
        // 'ownerTasks': reminders only for the Account Manager and the Chief doctor (accounts closing, vendor & lab payments, tallies)
        allow read: if (d != 'ownerTasks' && (clinicMember(o) || supportOpen(o))) || (d == 'ownerTasks' && (isOwner(o) || supportOpen(o)));
        // 'reminders': patient reminders (follow-ups, summaries, documents, missed patients) shared with everyone in the clinic
        allow write: if (d == 'counter' && (perm(o, 'patients') || perm(o, 'billing')))
          || (d == 'accounts' && perm(o, 'accounts')) || (d == 'settings' && perm(o, 'setup'))
          || (d == 'reminders' && clinicMember(o)) || (d == 'orgTasks' && clinicMember(o))
          || (d == 'ownerTasks' && (isOwner(o) || perm(o, 'accounts')));
      }
      // Patient assists: one record per assistant per treatment. Created pending (by the assistant, or by whoever saves the visit's
      // treatments, or by an admin for anyone, any date). The treating doctor (approverUid), the Chief doctor (perm assistApprove) or an
      // admin decides once: pending → approved | rejected. Admins may correct any record; a correction of a decided record sends it back
      // to pending (re-approval). Nothing is ever deleted: a record is voided. No incentive amounts are stored here.
      match /assists/{x} {
        function asFields() { return ['uid', 'name', 'date', 'patientName', 'patientId', 'appointmentId', 'treatmentId', 'typeId', 'typeName', 'doctorId',
          'approverUid', 'note', 'status', 'addedBy', 'addedByName', 'at', 'history', 'approvedBy', 'approverName', 'approvedAt', 'rejectReason']; }
        allow read: if (clinicMember(o) && (resource.data.uid == request.auth.uid || resource.data.get('approverUid', '') == request.auth.uid))
          || isOrgAdmin(o) || perm(o, 'assistApprove') || perm(o, 'treatments') || supportOpen(o);
        allow create: if clinicMember(o) && request.resource.data.status == 'pending' && request.resource.data.keys().hasOnly(asFields())
          && request.resource.data.get('addedBy', request.auth.token.email) == request.auth.token.email
          && (request.resource.data.uid == request.auth.uid || perm(o, 'treatments') || isOrgAdmin(o));
        allow update: if request.resource.data.keys().hasOnly(asFields()) && (
          // the doctor decides, once
          ((perm(o, 'assistApprove') || isOrgAdmin(o) || (clinicMember(o) && resource.data.get('approverUid', '') == request.auth.uid))
            && resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected']
            && changed().hasOnly(['status', 'approvedBy', 'approverName', 'approvedAt', 'rejectReason']))
          // admins correct or void any record; a decided record that is corrected goes back to pending
          || (isOrgAdmin(o) && !changed().hasAny(['addedBy', 'at'])
            && (changed().hasOnly(['status', 'history']) || resource.data.status == 'pending' || request.resource.data.status == 'pending'))
          // whoever added a pending record (or its assistant) may withdraw it, or the visit may re-sync it
          || (clinicMember(o) && resource.data.status == 'pending' && request.resource.data.status in ['pending', 'void']
            && (resource.data.uid == request.auth.uid || resource.data.get('addedBy', '') == request.auth.token.email || perm(o, 'treatments'))
            && changed().hasOnly(['status', 'history'])));
        allow delete: if false;
      }
      // Incentive amounts and rates: read by the Owner, Account Manager and Chief doctor; written by admins only
      match /assistPay/{x} {
        allow read: if (isOrgAdmin(o) && clinicOn(o)) || (clinicMember(o) && mem(o).get('isChief', false) == true) || supportOpen(o);
        allow write: if isOrgAdmin(o) && clinicOn(o);
      }

      // Subscription billing: Super Admin writes, Account Manager can view
      match /invoices/{i} {
        allow read: if isSuper() || isOrgAdmin(o);
        allow write: if isSuper();
      }
    }

    // Personal Agenda boards (feature: agenda). Private to each person.
    function myOrg() { return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.orgId; }
    function canPlan() { return isSuper() || (isMember(myOrg()) && hasFeature(myOrg(), 'agenda')); }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && canPlan();
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid && canPlan();
      }
    }
  }
}
