// GENERATED by build.py from core/firestore.rules + features/*/rules.part: edit those, then run python3 build.py
rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Zenvora Loop: multi-organization security rules
//
//  Super Admin (email below)  → onboards / offboards organizations, sets features, theme & billing.
//                               Can NOT read an organization's people or attendance unless that
//                               organization's Account Manager approves a time-limited support request.
//  Account Manager (orgadmin) → admin of their own organization only: people, roles, hierarchy,
//                               approves support access, sees their billing.
//  Manager                    → sees and corrects their organization's attendance.
//  Employee                   → checks in / out, sees own attendance, uses enabled features.
//  Proxy attendance            → staff the Account Manager ticks (e.g. reception) can check others in and out.
//  Clinic (feature)           → patients, appointments, treatments, photos, billing, accounts, reports;
//                               each person's clinic access is set by the Account Manager.
//
//  Every organization's data lives under /orgs/{orgId}/…, so organizations never see each other.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuper() {
      return signedIn() && request.auth.token.email == 'mohanmd.official@gmail.com';   // ← Super Admin
    }
    function orgDoc(o) { return get(/databases/$(database)/documents/orgs/$(o)).data; }
    function mem(o) { return get(/databases/$(database)/documents/orgs/$(o)/members/$(request.auth.uid)).data; }
    function isMember(o) {
      return signedIn() && orgDoc(o).status == 'active'
        && mem(o).active == true && mem(o).get('removed', false) != true;
    }
    function isOrgAdmin(o) { return isMember(o) && mem(o).role == 'orgadmin'; }
    function isOrgManager(o) { return isMember(o) && mem(o).role in ['orgadmin', 'manager']; }
    function hasFeature(o, f) { return orgDoc(o).features.get(f, false) == true; }
    function supportOpen(o) { return isSuper() && orgDoc(o).get('supportUntil', 0) > request.time.toMillis(); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function clinicOn(o) { return hasFeature(o, 'clinic'); }
    function clinicMember(o) { return isMember(o) && clinicOn(o); }
    // Proxy attendance: people the Account Manager ticks (members/{uid}.attProxy) may check others in and out
    function isProxy(o) { return isMember(o) && hasFeature(o, 'attendance') && mem(o).get('attProxy', false) == true; }
    function regAfter(o, id) { return getAfter(/databases/$(database)/documents/orgs/$(o)/attRegs/$(id)).data; }
    function memberOf(o, uid) { return get(/databases/$(database)/documents/orgs/$(o)/members/$(uid)).data; }
    function approverOf(o, uid) {
      return memberOf(o, uid).get('reportsTo', '') != '' ? memberOf(o, uid).reportsTo : orgDoc(o).get('adminUid', '');
    }
    function isOwner(o) { return clinicMember(o) && (mem(o).role == 'orgadmin' || mem(o).get('isChief', false) == true); }
    function perm(o, p) { return clinicMember(o) && (mem(o).role == 'orgadmin' || mem(o).get('perms', {}).get(p, false) == true); }

    // Login directory: which organization a user belongs to
    match /accounts/{uid} {
      allow read: if isSuper() || (signedIn() && request.auth.uid == uid);
      allow create: if isSuper()
        || (request.resource.data.keys().hasOnly(['orgId', 'email', 'createdAt'])
            && isOrgAdmin(request.resource.data.orgId));
      allow update, delete: if isSuper();
    }

    match /orgs/{o} {
      allow read: if isSuper() || isMember(o);
      allow create: if isSuper() && request.resource.data.get('supportUntil', 0) == 0;
      // Super Admin manages plan/features/status but can't grant itself support access;
      // the Account Manager can only approve/revoke support access and keep the seat count.
      allow update: if (isSuper() && !changed().hasAny(['supportUntil', 'supportBy']))
        || (isOrgAdmin(o) && changed().hasOnly(['supportUntil', 'supportBy', 'seats', 'logo', 'homeDefault', 'planner']));

      // Planning Board, shared tasks: a task given to a colleague. Only its reporter (createdBy), its assignee
      // and the Account Manager can see it. Who may give tasks is the Account Manager's switch: orgs/{o}.planner.assign
      function planOn() { return isMember(o) && hasFeature(o, 'agenda'); }
      function assignMode() { return orgDoc(o).get('planner', {}).get('assign', 'all'); }
      function canAssign() { return assignMode() == 'all' || (assignMode() == 'mgr' && isOrgManager(o)); }
      match /tasks/{t} {
        allow read: if planOn() && (resource.data.createdBy == request.auth.uid
          || resource.data.assigneeUid == request.auth.uid || isOrgAdmin(o));
        allow create: if planOn() && canAssign() && request.resource.data.createdBy == request.auth.uid;
        allow update: if planOn()
          && (resource.data.createdBy == request.auth.uid || resource.data.assigneeUid == request.auth.uid || isOrgAdmin(o))
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.get('assigneeUid', '') == resource.data.get('assigneeUid', '') || canAssign()
              || resource.data.createdBy == request.auth.uid);
        allow delete: if planOn() && (resource.data.createdBy == request.auth.uid || isOrgAdmin(o));
      }
      // People directory for picking an assignee: names & titles only (members/ stays private to managers)
      match /dir/{uid} {
        allow read: if isMember(o);
        allow create, update: if isOrgAdmin(o)
          || (isMember(o) && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'title', 'active', 'at'])
              && request.resource.data.active == true);
        allow delete: if isOrgAdmin(o);
      }

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isOrgManager(o) || supportOpen(o) || isProxy(o);
        // Super Admin may only create the Account Manager it has just assigned on the org
        allow create: if isOrgAdmin(o)
          || (isSuper() && request.resource.data.role == 'orgadmin' && orgDoc(o).get('adminUid', '') == uid);
        allow update: if isOrgAdmin(o)
          || (isOrgManager(o) && changed().hasOnly(['att']))
          || (signedIn() && request.auth.uid == uid && changed().hasOnly(['mustChangePassword', 'lastLogin'])
              && request.resource.data.mustChangePassword == false);
      }


      // Support access requests: Super Admin asks, Account Manager decides
      match /accessRequests/{r} {
        allow read: if isSuper() || isOrgAdmin(o);
        allow create: if isSuper() && request.resource.data.status == 'pending';
        allow update: if isOrgAdmin(o) || (isSuper() && request.resource.data.status == 'cancelled');
      }

      // Logins that existed before organizations: Super Admin moves them in, Account Manager adds them
      match /pending/{uid} {
        allow read, delete: if isOrgAdmin(o);
        allow create: if isSuper();
      }

      // Feature rules: build.py puts each features/<name>/rules.part here
      // ── feature: Payroll (Attendance) (features/payroll/rules.part) ──
      // Attendance (feature: attendance). Staff check-ins are stamped with server time.
      match /attendance/{uid}/events/{eventId} {
        allow read: if (hasFeature(o, 'attendance')
                        && (isOrgManager(o) || isProxy(o) || (signedIn() && request.auth.uid == uid && isMember(o))))
          || supportOpen(o);
        allow create: if hasFeature(o, 'attendance') && (isOrgManager(o)
          || (signedIn() && request.auth.uid == uid && isMember(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src'])
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.src == 'self'
              && request.resource.data.at == request.time)
          || (isProxy(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src', 'by'])
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.src == 'proxy'
              && request.resource.data.by == request.auth.uid
              && request.resource.data.at == request.time)
          // an approved regularization: written by the person who approved it, at exactly the requested time
          || (isMember(o)
              && request.resource.data.keys().hasOnly(['type', 'at', 'src', 'reg', 'by'])
              && request.resource.data.src == 'reg'
              && request.resource.data.type in ['in', 'out']
              && request.resource.data.by == request.auth.uid
              && eventId == request.resource.data.reg + '-' + request.resource.data.type
              && regAfter(o, request.resource.data.reg).uid == uid
              && regAfter(o, request.resource.data.reg).status == 'approved'
              && regAfter(o, request.resource.data.reg).decidedBy == request.auth.uid
              && request.resource.data.at.toMillis() == regAfter(o, request.resource.data.reg).get(request.resource.data.type == 'in' ? 'inAt' : 'outAt', -1)));
        allow update, delete: if hasFeature(o, 'attendance') && isOrgManager(o);
      }

      // Attendance regularization requests: the person (or a Proxy attendance person for them) asks;
      // their immediate reporting manager (or the Account Manager if they report to no one) approves.
      match /attRegs/{r} {
        allow read: if hasFeature(o, 'attendance') && isMember(o)
          && (resource.data.uid == request.auth.uid || resource.data.by == request.auth.uid
              || resource.data.approver == request.auth.uid || isOrgAdmin(o));
        allow create: if hasFeature(o, 'attendance') && isMember(o)
          && request.resource.data.status == 'pending'
          && request.resource.data.by == request.auth.uid
          && (request.resource.data.uid == request.auth.uid || isProxy(o))
          && request.resource.data.approver != request.resource.data.uid
          && request.resource.data.approver == approverOf(o, request.resource.data.uid);
        allow update: if hasFeature(o, 'attendance') && isMember(o)
          && (resource.data.approver == request.auth.uid || isOrgAdmin(o))
          && resource.data.uid != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.decidedBy == request.auth.uid
          && changed().hasOnly(['status', 'decidedBy', 'decidedName', 'decidedAt']);
        allow delete: if isMember(o) && resource.data.by == request.auth.uid && resource.data.status == 'pending';
      }

      // ── feature: Dental Clinic (features/dental-clinic/rules.part) ──
      // ── Clinic (feature: clinic). Who may do what is set per person by the Account Manager (members/{uid}.perms).
      match /patients/{pid} {
        allow read: if perm(o, 'patients') || perm(o, 'appointments') || perm(o, 'treatments') || perm(o, 'billing') || supportOpen(o);
        allow create: if perm(o, 'patients');
        allow update: if perm(o, 'patients') || perm(o, 'treatments');
        allow delete: if isOrgAdmin(o) && clinicOn(o);
        match /photos/{ph} {
          allow read: if perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'treatments');
        }
        match /photoData/{ph} {
          allow read: if perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'treatments');
        }
        match /docs/{dk} {
          allow read: if perm(o, 'patients') || perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'patients') || perm(o, 'treatments');
        }
        match /docData/{dk} {
          allow read: if perm(o, 'patients') || perm(o, 'treatments') || supportOpen(o);
          allow create, update, delete: if perm(o, 'patients') || perm(o, 'treatments');
        }
      }
      match /appointments/{a} {
        allow read: if perm(o, 'appointments') || perm(o, 'treatments') || perm(o, 'reports') || perm(o, 'doctorReports') || supportOpen(o);
        allow write: if perm(o, 'appointments') || perm(o, 'treatments');
      }
      match /treatments/{t} {
        allow read: if perm(o, 'treatments') || perm(o, 'billing') || perm(o, 'reports') || perm(o, 'doctorReports') || perm(o, 'accounts') || supportOpen(o);
        allow create, delete: if perm(o, 'treatments');
        allow update: if perm(o, 'treatments') || (perm(o, 'patients') && changed().hasOnly(['docAttached']));
      }
      match /payments/{p} {
        allow read: if perm(o, 'billing') || perm(o, 'reports') || perm(o, 'accounts') || perm(o, 'tally') || supportOpen(o);
        allow write: if perm(o, 'billing');
      }
      // Accounts ledger: income, expenses & bills, petty cash, consultant payments.
      // Front desk may only record petty cash spends; only Accounts (the owner) tops petty cash up.
      match /ledger/{l} {
        allow read: if perm(o, 'accounts') || perm(o, 'reports') || supportOpen(o) || isOwner(o)
          || (perm(o, 'petty') && resource.data.kind in ['petty', 'pettyspend'])
          || (perm(o, 'tally') && resource.data.kind == 'expense');
        // the Chief doctor (owner) may enter the per-patient cost of a consultant's visit (ledger id cf-<appointmentId>)
        allow create: if perm(o, 'accounts') || (perm(o, 'petty') && request.resource.data.kind == 'pettyspend')
          || (isOwner(o) && l == 'cf-' + request.resource.data.appointmentId && request.resource.data.kind == 'expense')
          // billing: a patient's change taken from the petty box (ledger chg-<paymentId>, written with the payment)
          || (perm(o, 'billing') && l == 'chg-' + request.resource.data.paymentId && request.resource.data.kind == 'pettyspend' && request.resource.data.change == true);
        allow update: if perm(o, 'accounts')
          || (isOwner(o) && l == 'cf-' + request.resource.data.appointmentId && request.resource.data.kind == 'expense' && resource.data.appointmentId == request.resource.data.appointmentId);
        allow delete: if perm(o, 'accounts') || (isOwner(o) && l == 'cf-' + resource.data.appointmentId)
          || (perm(o, 'billing') && l == 'chg-' + resource.data.paymentId && resource.data.get('change', false) == true);    // deleting the payment gives the change back
      }
      // Audit log: a copy of every deleted money record (ledger entries, tallies). Write-once: nobody can change or remove it.
      match /auditLog/{x} {
        allow read: if perm(o, 'accounts') || isOwner(o) || supportOpen(o);
        allow create: if (perm(o, 'accounts') || perm(o, 'tally') || perm(o, 'petty') || isOwner(o)) && request.resource.data.by == request.auth.token.email;
        allow update, delete: if false;
      }
      match /ledgerDocs/{l} {
        allow read, write: if perm(o, 'accounts');
      }
      match /tallies/{d} {
        allow read: if perm(o, 'accounts') || perm(o, 'tally') || perm(o, 'reports') || supportOpen(o);
        allow write: if perm(o, 'accounts') || perm(o, 'tally');
      }
      match /vendors/{v} {
        allow read: if perm(o, 'accounts') || perm(o, 'reports') || supportOpen(o);
        allow write: if perm(o, 'accounts');
      }
      match /doctors/{d} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /treatmentTypes/{t} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /medicines/{m} {
        allow read: if clinicMember(o) || supportOpen(o);
        allow write: if perm(o, 'setup');
      }
      match /clinicMeta/{d} {
        // 'orgTasks': organization reminders everyone shares and anyone may close (patient follow-ups, documents, descriptions)
        // 'ownerTasks': reminders only for the Account Manager and the Chief doctor (accounts closing, vendor & lab payments, tallies)
        allow read: if (d != 'ownerTasks' && (clinicMember(o) || supportOpen(o))) || (d == 'ownerTasks' && (isOwner(o) || supportOpen(o)));
        // 'reminders': patient reminders (follow-ups, summaries, documents, missed patients) shared with everyone in the clinic
        allow write: if (d == 'counter' && (perm(o, 'patients') || perm(o, 'billing')))
          || (d == 'accounts' && perm(o, 'accounts')) || (d == 'settings' && perm(o, 'setup'))
          || (d == 'reminders' && clinicMember(o)) || (d == 'orgTasks' && clinicMember(o))
          || (d == 'ownerTasks' && (isOwner(o) || perm(o, 'accounts')));
      }
      // Patient assists: staff log who they assisted each day; the Chief doctor (perm assistApprove) approves.
      // Staff see only their own entries and the approval status, never the incentive amount.
      match /assists/{x} {
        allow read: if (clinicMember(o) && resource.data.uid == request.auth.uid)
          || isOrgAdmin(o) || perm(o, 'assistApprove') || supportOpen(o);
        allow create: if clinicMember(o) && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if (perm(o, 'assistApprove') && changed().hasOnly(['status', 'approvedBy', 'approvedAt', 'approverName']))
          || (clinicMember(o) && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
              && request.resource.data.status == 'pending' && request.resource.data.uid == request.auth.uid);
        allow delete: if isOrgAdmin(o)
          || (clinicMember(o) && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
      }
      // Incentive amounts and rates: Account Manager only
      match /assistPay/{x} {
        allow read, write: if isOrgAdmin(o) && clinicOn(o);
      }

      // Subscription billing: Super Admin writes, Account Manager can view
      match /invoices/{i} {
        allow read: if isSuper() || isOrgAdmin(o);
        allow write: if isSuper();
      }
    }

    // Personal Agenda boards (feature: agenda). Private to each person.
    function myOrg() { return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.orgId; }
    function canPlan() { return isSuper() || (isMember(myOrg()) && hasFeature(myOrg(), 'agenda')); }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && canPlan();
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid && canPlan();
      }
    }
  }
}
